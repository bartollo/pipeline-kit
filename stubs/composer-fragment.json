{
    "require-dev": {
        "heyosseus/sloppy": "^1.2",
        "larastan/larastan": "^3.12",
        "laravel/boost": "^2.10",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=2G",
        "pest": "pest --parallel",
        "types": "php -d memory_limit=1G vendor/bin/pest --type-coverage --min=95",
        "mutate": "pest --mutate --parallel --covered-only --min=80",
        "sloppy": "sloppy scan",
        "sloppy:diff": "sloppy diff main --fail-on=high",
        "sloppy:review": "sloppy review main",
        "security": "composer audit",
        "quality": [
            "@lint",
            "@analyse",
            "@pest",
            "@types",
            "@sloppy:diff",
            "@security"
        ]
    }
}
